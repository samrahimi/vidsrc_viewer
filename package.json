{
    "name": "vlix",
    "version": "1.2.0",
    "main": "main.js",
    "scripts": {
        "build:android": "npx cap sync android",
        "start": "electron .",
        "build": "echo 'Ready to go!",
        "dist": "electron-builder"
    },
    "build": {
        "appId": "com.vlix.desktop",
        "productName": "Vlix",
        "mac": {
            "category": "public.app-category.video",
            "target": "dmg"
        },
        "win": {
            "target": "nsis"
        },
        "linux": {
            "target": "AppImage"
        }
    },
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^24.13.3"
    },
    "dependencies": {
        "@capacitor/android": "^7.4.4",
        "@capacitor/cli": "^7.4.4",
        "@capacitor/core": "^7.4.4",
        "@capgo/capacitor-updater": "^7.29.0",
        "adm-zip": "^0.5.16"
    }
}