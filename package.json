{
    "name": "chatflix",
    "version": "1.0.0",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "build": "echo 'Ready to go!",
        "dist": "electron-builder"
    },
    "build": {
        "appId": "com.chatflix.desktop",
        "productName": "Chatflix",
        "mac": {
            "category": "public.app-category.video",
            "target": "dmg"
        },
        "win": {
            "target": "nsis"
        },
        "linux": {
            "target": "AppImage"
        }
    },
    "devDependencies": {
        "electron": "^28.0.0",
        "electron-builder": "^24.9.0"
    }
}